# Offline 3-server cluster. Copy to .env.offline and replace every CHANGE_ME.
# Same file on all three servers.

# ── secrets (CHANGE_ME) ──
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=kbminio
MINIO_SECRET_KEY=CHANGE_ME
NEBULA_PASSWORD=nebula
RABBITMQ_USER=kb
RABBITMQ_PASSWORD=CHANGE_ME
LITELLM_API_KEY=sk-CHANGE_ME
API_KEYS=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# unused (graph = nebula) but prod preflight rejects the default
NEO4J_PASSWORD=CHANGE_ME

# ── endpoints ──
LITELLM_BASE_URL=http://10.10.113.12:4000
API_CORS_ORIGINS=http://10.10.113.12:8000
TEMPORAL_UI_CORS=http://10.10.113.12:8080

# ── models (aliases from litellm_config.offline.yaml) ──
LITELLM_MODEL_SMALL=small
LITELLM_MODEL_LARGE=large
LITELLM_EMBEDDING_MODEL=bge-m3
MILVUS_DIM=1024

# ── concurrency: 2 ingest llama-servers x 6 slots = 12 parallel extract calls ──
LLM_POOL_N=12
INGEST_ADMISSION_MAX_INFLIGHT=4
TEMPORAL_LLM_ACTIVITY_CONCURRENCY=14
TEMPORAL_MERGE_ACTIVITY_CONCURRENCY=14
INGEST_QUEUE_BACKEND=rabbitmq

# ── graph / analytics ──
GRAPH_BACKEND=nebula
TEMPORAL_COMMUNITY_BACKEND=leidenalg
EVENTS_FIRST_SEEN_ENABLED=true
# litellm admin UI login (user: admin)
LITELLM_UI_PASSWORD=CHANGE_ME
# incremental ER across documents: kNN over Milvus entity_er_vec (nebula has no Cypher window)
AGENT_ER_USE_NATIVE_VECTOR_KNN=true
# dsh-web (srv01) -> KB MCP servers: must be one of API_KEYS
KB_MCP_TOKEN=CHANGE_ME
