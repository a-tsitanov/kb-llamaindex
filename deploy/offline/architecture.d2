# Офлайн-кластер KB: что и как раскатано (состояние 2026-10-06)
# Рендер: node ~/.claude/skills/d2/scripts/render.mjs deploy/offline/architecture.d2 deploy/offline/architecture.svg --layout elk

direction: down

title: |md
  # Офлайн-кластер базы знаний — ext22-srv01/02/03 (2026-10-06)
  3× Supermicro SBI-4129P-C2N · 2× Xeon Gold 5218R · 256 ГБ · без GPU · без интернета · Docker compose `-p kb` поверх `docker-compose.prod.yml`
| {near: top-center}

classes: {
  data: {style: {fill: "#E8F1FB"; stroke: "#3B7BC8"; border-radius: 6}}
  app: {style: {fill: "#EAF7EC"; stroke: "#3E9A55"; border-radius: 6}}
  llm: {style: {fill: "#FFF3E0"; stroke: "#E08A1E"; border-radius: 6}}
  ui: {style: {fill: "#F3E8FB"; stroke: "#8A4FC8"; border-radius: 6}}
  ops: {style: {fill: "#F2F2F2"; stroke: "#888888"; border-radius: 6; font-color: "#444444"}}
  socket: {style: {fill: "#FFFFFF"; stroke: "#BBBBBB"; stroke-dash: 4}}
  server: {style: {fill: "#FAFAFA"; stroke: "#555555"; stroke-width: 2; font-size: 20; bold: true}}
  primary: {style: {stroke: "#E08A1E"; stroke-width: 3}}
  fallback: {style: {stroke: "#E08A1E"; stroke-dash: 5}}
  tunnel: {style: {stroke: "#8A4FC8"; stroke-dash: 3; stroke-width: 2}}
}

user: Пользователь (мак)\nVPN ppp0 10.10.240.x {
  shape: person
  class: ui
}

gpu: GPU-узел 10.10.151.15 {
  class: server
  vllm: vLLM :8000\ndeepseek-v4-flash\n262k ctx · основная модель {class: llm}
}

srv01: srv01 · 10.10.113.11 · ДАННЫЕ {
  class: server
  s0: сокет 0 (ядра 0-19,40-59) {
    class: socket
    pg: Postgres 16 :5432\nkb_llamaindex · temporal · litellm {class: data}
    milvus: Milvus 2.4 :19530\nchunks · entity_er_vec {class: data}
    etcd: etcd {class: data}
    minio: MinIO :9000 / :9101\nkb-uploads · kb-staging {class: data}
    nebula: NebulaGraph 3.8\ngraphd :9669 · metad · storaged\nspace kb {class: data}
    redis: Redis :6379 {class: data}
    rabbit: RabbitMQ :5672 / :15672\ningest.pending · ingest.dlq {class: data}
  }
  s1: сокет 1 (ядра 20-39,60-79) {
    class: socket
    embed: llama.cpp :8081\nbge-m3 FP16 (1024) {class: llm}
    docs2md: docs2md :8070\nOCR выключен {class: app}
    dsh: dsh-web 127.0.0.1:3080\nDeepSeek Harness 0.2.0-rc.2\nnetwork_mode: host · cookie 365 дн\nLAN 10.10.113.11:3080 через lan-proxy\n(белый список 10.10.0.0/16) {class: ui}
    dshplug: плагин dsh-kb-ingest\n/kb-ingest · /kb-status\nkb_ingest_file · kb_ingest_status {class: ui}
    dsh -> dshplug: {style.stroke-dash: 2}
  }
  hostsvc: хост: chrony (NTP-сервер, stratum 8) · opensm (IB 100G) {class: ops}
}

srv02: srv02 · 10.10.113.12 · ПРИЛОЖЕНИЕ + ПОИСК {
  class: server
  s0: сокет 0 {
    class: socket
    webui: webui :8090\nформа загрузки + поиск {class: ui}
    api: API :8000\nX-API-Key {class: app}
    consumer: ingest-consumer\nK=4 документа {class: app}
    worker: worker (rerank)\nmain·merge·search·large·graph_build·wiki·scheduler·monitor\nER kNN по Milvus = ON {class: app}
    mcp: MCP :9001 search · :9002 tools · :9003 stats\nBearer API_KEYS {class: app}
    temporal: Temporal :7233\nUI :8080 {class: app}
    litellm: LiteLLM :4000 · UI /ui\nsmall · large · bge-m3 {class: llm}
    mon: Prometheus :9092 · Grafana :3001 {class: ops}
  }
  s1: сокет 1 {
    class: socket
    llmsearch: llama.cpp :8085\nQwen3-30B-A3B Q4\nlarge-cpu (резерв) {class: llm}
  }
}

srv03: srv03 · 10.10.113.13 (/23) · LLM ДЛЯ INGEST {
  class: server
  s0: сокет 0 {
    class: socket
    ing0: llama.cpp :8082\nQwen3-30B-A3B Q4\nsmall-cpu (резерв) {class: llm}
    workerllm: worker-llm\nпул llm · LLM_POOL_N=8 {class: app}
  }
  s1: сокет 1 {
    class: socket
    ing1: llama.cpp :8083\nQwen3-30B-A3B Q4\nsmall-cpu (резерв) {class: llm}
  }
}

# ── доступ пользователя ──
user -> srv01.s1.dsh: http://10.10.113.11:3080 (токен → cookie) {class: tunnel}
user -> srv02.s0.webui: :8090 (напрямую или туннель) {class: tunnel}

# ── загрузка документов ──
srv02.s0.webui -> srv01.s1.docs2md: /convert → Markdown
srv02.s0.webui -> srv02.s0.api: /api/v1/ingest
srv01.s1.dshplug -> srv02.s0.webui: /api/convert → /api/ingest
srv02.s0.api -> srv01.s0.rabbit: ingest.pending
srv02.s0.consumer -> srv01.s0.rabbit: prefetch K
srv02.s0.consumer -> srv02.s0.temporal: DocumentIngestWorkflow

# ── оркестрация ──
srv02.s0.worker -> srv02.s0.temporal: пулы задач
srv03.s0.workerllm -> srv02.s0.temporal: extract_kg

# ── хранилища (связи к блоку данных целиком) ──
srv02.s0.worker -> srv01.s0: PG · Milvus · Nebula · MinIO · Redis
srv03.s0.workerllm -> srv01.s0: MinIO staging
srv02.s0.temporal -> srv01.s0: Postgres
srv02.s0.mcp -> srv01.s0: Nebula · Milvus · PG
srv01.s0.milvus -> srv01.s0.etcd
srv01.s0.milvus -> srv01.s0.minio

# ── модели через LiteLLM ──
srv02.s0.worker -> srv02.s0.litellm
srv03.s0.workerllm -> srv02.s0.litellm
srv01.s1.dsh -> srv02.s0.litellm: large (по умолч.) / small
srv02.s0.litellm -> gpu.vllm: small (без размышлений)\nlarge (с размышлениями) {class: primary}
srv02.s0.litellm -> srv03.s0.ing0: резерв small {class: fallback}
srv02.s0.litellm -> srv03.s1.ing1: резерв small {class: fallback}
srv02.s0.litellm -> srv02.s1.llmsearch: резерв large {class: fallback}
srv02.s0.litellm -> srv01.s1.embed: bge-m3
srv02.s0.litellm -> srv01.s0: БД litellm (UI)

# ── агент ──
srv01.s1.dsh -> srv02.s0.mcp: MCP streamable-http

legend: Обозначения {
  near: bottom-right
  class: ops
  a: данные {class: data}
  b: приложение {class: app}
  c: модели {class: llm}
  d: интерфейсы {class: ui}
  e: служебное {class: ops}
  f: "→ сплошная оранжевая = GPU (основной путь)\n⇢ пунктир оранжевый = CPU-резерв\n⇢ фиолетовый пунктир = доступ пользователя" {shape: text}
}
